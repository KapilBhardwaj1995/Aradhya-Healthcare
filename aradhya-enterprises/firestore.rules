rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'admin' || 
        request.auth.token.role == 'admin'
      );
    }
    
    function isEmployee() {
      return isAuthenticated() && (
        getUserData().role == 'employee' || 
        request.auth.token.role == 'employee' ||
        isAdmin()
      );
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Users collection: users can read/update their own profile; Admin can read all
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // 2. Categories: Public can read active categories; Only Admin can write
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3. Products: Public can read; Only Admin can create, update, delete
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Order Requests: Customers can create requests; Users can read their own; Admin has full access
    match /orderRequests/{requestId} {
      allow create: if true; // Guest or customer can submit order requests
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // 5. Production Logs: STRICT PRIVACY
    // Customers CANNOT see production
    // Employees can create logs and see their own entries
    // Admin can view, approve, and manage all production records
    match /production/{logId} {
      allow create: if isEmployee();
      allow read: if isAdmin() || (isEmployee() && resource.data.employeeId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // 6. Customer Inquiries: Anyone can submit inquiry; Only Admin can view/respond
    match /customerInquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // 7. Audit Logs: Strictly Admin access
    match /auditLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // 8. Company Settings: Public can read basic settings; Only Admin can write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
